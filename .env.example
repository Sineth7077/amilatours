# Production site URL (no trailing slash). Used for canonical URLs and Open Graph tags.
# Leave unset in local development.
VITE_SITE_URL=https://example.com

# Optional: POST endpoint that receives inquiry JSON.
# Works with Formspree, Basin, Getform, or your own serverless function.
# When unset, the form validates details and hands them to the traveller as a
# ready-to-send WhatsApp / email message instead of silently dropping them.
VITE_INQUIRY_ENDPOINT=
